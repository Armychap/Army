<Window x:Class="ArmyBattle.UI.BattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚔ Арена Битвы"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#1a1f2e"/>
            <Setter Property="BorderBrush" Value="#2a3a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Army1NameLbl" Text="Армия 1" FontSize="18" FontWeight="Bold"
                           Foreground="#4ecdc4" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="ХОД" Foreground="#a09080" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RoundLbl" Text="0" FontSize="36" FontWeight="Bold"
                               Foreground="#ffd93d" FontFamily="Courier New" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FormationLbl" Text="—" Foreground="#95e1d3" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Army2NameLbl" Text="Армия 2" FontSize="18" FontWeight="Bold"
                           Foreground="#ff6b6b" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Army 1 Roster -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelBorder}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock x:Name="Army1CountLbl" Text="Живых: —" Foreground="#4ecdc4" FontWeight="Bold" FontSize="12"/>
                        <Border Background="#0a1419" Height="5" CornerRadius="3" Margin="0,5,0,0">
                            <Border x:Name="Army1Bar" Background="#4ecdc4" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Buffs -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelBorder}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="🔰 Баффы:" Foreground="#ffd93d" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="Army1BuffsLbl" Text="—" Foreground="#a09080" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Army1RosterPanel" Orientation="Vertical"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Battle Field -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#0a0f1a">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- Combatants area (filled in code) -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both">
                        <Grid x:Name="CombatGrid" Margin="0,0,0,8"/>
                    </ScrollViewer>

                    <!-- Battle log -->
                    <Border Grid.Row="1" Background="#0d1520" BorderBrush="#1a2a3a" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📜 Летопись боя" Foreground="#a09080" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LogPanel" Orientation="Vertical"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Army 2 Roster -->
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelBorder}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock x:Name="Army2CountLbl" Text="Живых: —" Foreground="#ff6b6b" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                        <Border Background="#0a1419" Height="5" CornerRadius="3" Margin="0,5,0,0">
                            <Border x:Name="Army2Bar" Background="#ff6b6b" Height="5" CornerRadius="3" HorizontalAlignment="Right" Width="0"/>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Buffs -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelBorder}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="🔰 Баффы:" Foreground="#ffd93d" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="Army2BuffsLbl" Text="—" Foreground="#a09080" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Army2RosterPanel" Orientation="Vertical"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- BUTTONS -->
        <Border Grid.Row="2" Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="UndoBtn" Content="↩ Отменить" Width="115"
                            Background="#1a2a3a" Foreground="#95e1d3" BorderBrush="#2a4a5a" BorderThickness="1"
                            Style="{StaticResource ActionBtn}" Padding="10,0" Margin="0,0,8,0"
                            Click="UndoBtn_Click" IsEnabled="False"/>
                    <Button x:Name="RedoBtn" Content="↪ Повторить" Width="115"
                            Background="#1a2a3a" Foreground="#95e1d3" BorderBrush="#2a4a5a" BorderThickness="1"
                            Style="{StaticResource ActionBtn}" Padding="10,0" Margin="0,0,8,0"
                            Click="RedoBtn_Click" IsEnabled="False"/>
                    <Button x:Name="FormationBtn" Content="⚙ Построение" Width="125"
                            Background="#2a2a1a" Foreground="#ffd93d" BorderBrush="#3a3a1a" BorderThickness="1"
                            Style="{StaticResource ActionBtn}" Padding="10,0"
                            Click="FormationBtn_Click"/>
                </StackPanel>

                <!-- Center -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="MoveBtn" Content="▶ Сделать ход" Width="150"
                            Background="#1a3a2a" Foreground="#2ecc71" BorderBrush="#2ecc71" BorderThickness="2"
                            Style="{StaticResource ActionBtn}" Padding="14,0" Margin="0,0,12,0"
                            Click="MoveBtn_Click"/>
                    <Button x:Name="AutoBtn" Content="⚡ Авто до конца" Width="145"
                            Background="#2a2a1a" Foreground="#ffd93d" BorderBrush="#ffd93d" BorderThickness="2"
                            Style="{StaticResource ActionBtn}" Padding="14,0"
                            Click="AutoBtn_Click"/>
                </StackPanel>

                <!-- Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveBtn" Content="💾 Сохранить" Width="125"
                            Background="#1a2a3a" Foreground="#4ecdc4" BorderBrush="#4ecdc4" BorderThickness="1"
                            Style="{StaticResource ActionBtn}" Padding="10,0" Margin="0,0,8,0"
                            Click="SaveBtn_Click"/>
                    <Button x:Name="ExitBtn" Content="✖ Выйти" Width="100"
                            Background="#2a1a1a" Foreground="#ff6b6b" BorderBrush="#ff6b6b" BorderThickness="1"
                            Style="{StaticResource ActionBtn}" Padding="10,0"
                            Click="ExitBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
