<Window x:Class="ArmyBattle.UI.ManualArmyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сборка Армии"
        Width="820"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="UnitCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#1a2a3a"/>
            <Setter Property="BorderBrush"
                    Value="#2a3a4a"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
            <Setter Property="Padding"
                    Value="12,10"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>
        <Style x:Key="ActionBtnStyle"
               TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1a1f2e"
                BorderBrush="#2a3a4a"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Text="Армия"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#ffd93d"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBlock Text="Бюджет: "
                               Foreground="#a09080"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="BudgetText"
                               Text="0/500"
                               Foreground="#4ecdc4"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN: two-column layout -->
        <Grid Grid.Row="1"
              Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: available units -->
            <DockPanel x:Name="LeftPanel"
                       Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Доступные юниты (нажмите, чтобы добавить):"
                           Foreground="#95e1d3"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">

                        <!-- Weak Fighter -->
                        <Border x:Name="AddWeakBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddWeak_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🗡️"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Слабый боец"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 10"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 8"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="❤ 25"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="15 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Archer -->
                        <Border x:Name="AddArcherBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddArcher_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🏹"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Лучник"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 5"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 3"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="❤ 18"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a1a3a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="✨ Дальний удар"
                                                       Foreground="#95e1d3"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="25 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Healer -->
                        <Border x:Name="AddHealerBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddHealer_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✙"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Лекарь"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 3"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 2"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="❤ 15"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a1a3a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="✨ Лечение"
                                                       Foreground="#95e1d3"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="20 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Wizard -->
                        <Border x:Name="AddWizardBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddWizard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔮"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Маг"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 7"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 4"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="❤ 22"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a1a3a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="✨ Клон 30%"
                                                       Foreground="#95e1d3"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="30 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Strong Fighter -->
                        <Border x:Name="AddStrongBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddStrong_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🪖"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Сильный боец"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 20"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 15"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="❤ 60"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="40 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Shield Wall -->
                        <Border x:Name="AddShieldWallBorder"
                                Style="{StaticResource UnitCardStyle}"
                                MouseDown="AddShieldWall_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🧱"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Гуляй город"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#e0d5c7"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <Border Background="#2a1a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="⚔ 0"
                                                       Foreground="#ff6b6b"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a2a3a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="🛡 50"
                                                       Foreground="#4ecdc4"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#1a3a1a"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="❤ 70"
                                                       Foreground="#2ecc71"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Background="#3a2a1a"
                                                CornerRadius="4"
                                                Padding="5,2">
                                            <TextBlock Text="Не атакует"
                                                       Foreground="#a09080"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#2a3040"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="55 💰"
                                               Foreground="#ffd93d"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Divider -->
            <Border x:Name="Divider"
                    Grid.Column="1"
                    Width="1"
                    Background="#2a3a4a"/>

            <!-- RIGHT: army roster -->
            <DockPanel x:Name="RightPanel"
                    Grid.Column="2"
                    Margin="14,0,0,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Состав армии:"
                           Foreground="#95e1d3"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="0,0,0,10"/>
                <Button x:Name="RemoveLastBtn"
                        DockPanel.Dock="Bottom"
                        Content="✖ Удалить последнего"
                        Click="RemoveLast_Click"
                        Background="#2a1a1a"
                        Foreground="#ff6b6b"
                        BorderBrush="#ff6b6b"
                        BorderThickness="1"
                        Height="32"
                        Margin="0,10,0,0"
                        Style="{StaticResource ActionBtnStyle}"
                        Padding="8,0"
                        Visibility="Visible"/>
                <ScrollViewer x:Name="UnitsScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="UnitsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1a2030"
                                        BorderBrush="#2a3a4a"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"/>

                                        <!-- Информация -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0">
                                            <TextBlock FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#e0d5c7">
                                    <Run Text="{Binding Name}"/> <Run Text="#"/><Run Text="{Binding FighterNumber}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,3,0,0">
                                                <TextBlock FontSize="9"
                                                           Foreground="#2ecc71"
                                                           Margin="0,0,8,0">
                                        <Run Text="❤ "/><Run Text="{Binding Health}"/><Run Text="/"/><Run Text="{Binding MaxHealth}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="9"
                                                           Foreground="#a09080">
                                        <Run Text="⚔ "/><Run Text="{Binding Attack}"/>  <Run Text="🛡 "/><Run Text="{Binding Defence}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Стоимость -->
                                        <Border Grid.Column="2"
                                                Background="#2a3040"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Cost}"
                                                       Foreground="#ffd93d"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#1a1f2e"
                BorderBrush="#2a3a4a"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Добавьте хотя бы одного юнита"
                           Foreground="#a09080"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="CancelBtn"
                            Content="Отмена"
                            Click="Cancel_Click"
                            Width="90"
                            Height="36"
                            Background="#2a2a2a"
                            Foreground="#a09080"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionBtnStyle}"
                            Padding="10,0"/>
                    <Button x:Name="SaveBtn"
                            Content="✔ Готово"
                            Click="Save_Click"
                            Width="100"
                            Height="36"
                            Background="#1a3a2a"
                            Foreground="#2ecc71"
                            BorderBrush="#2ecc71"
                            BorderThickness="1"
                            Style="{StaticResource ActionBtnStyle}"
                            Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>