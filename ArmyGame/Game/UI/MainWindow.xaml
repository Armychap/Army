<Window x:Class="ArmyBattle.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚔ Главное Меню" 
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1a2a3a"/>
            <Setter Property="Foreground" Value="#e0d5c7"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#4ecdc4"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4ecdc4"/>
                                <Setter Property="Foreground" Value="#0f1419"/>
                                <Setter Property="BorderBrush" Value="#95e1d3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2eaa8f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="BorderBrush" Value="#ff6b6b"/>
            <Setter Property="Foreground" Value="#ff6b6b"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="0,0,0,2" Padding="20,16">
            <TextBlock Text="⚔ ГЛАВНОЕ МЕНЮ" FontSize="32" FontWeight="Bold" Foreground="#ffd93d" HorizontalAlignment="Center"/>
        </Border>

        <!-- MENU BUTTONS -->
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            
            <Button x:Name="NewGameBtn" Content="▶ Новая Игра" Style="{StaticResource MenuButtonStyle}" Click="NewGameBtn_Click" Margin="0,0,0,16"/>
            
            <Button x:Name="LoadGameBtn" Content="📁 Загрузить Игру" Style="{StaticResource MenuButtonStyle}" Click="LoadGameBtn_Click" Margin="0,0,0,16"/>
            
            <Button x:Name="GameHistoryBtn" Content="📜 История Игр" Style="{StaticResource MenuButtonStyle}" Click="GameHistoryBtn_Click" Margin="0,0,0,16"/>
            
            <Button x:Name="SettingsBtn" Content="⚙ Настройки" Style="{StaticResource MenuButtonStyle}" Click="SettingsBtn_Click" Margin="0,0,0,16"/>
            
            <Button x:Name="ClearHistoryBtn" Content="🗑 Очистить Историю" Style="{StaticResource DangerButtonStyle}" Click="ClearHistoryBtn_Click" Margin="0,0,0,16"/>
            
            <Button x:Name="ExitBtn" Content="❌ Выход" Style="{StaticResource DangerButtonStyle}" Click="ExitBtn_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
