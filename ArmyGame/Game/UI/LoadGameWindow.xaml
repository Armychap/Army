<Window x:Class="ArmyBattle.UI.LoadGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📁 Загрузить Игру" 
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Сохранённые Игры" FontSize="24" FontWeight="Bold" Foreground="#ffd93d" Margin="0,0,0,16"/>

        <!-- GAME LIST -->
        <ListBox Grid.Row="1" x:Name="GameListBox" Background="#1a1f2e" Foreground="#e0d5c7" 
                 BorderBrush="#2a3a4a" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Загрузить" Width="120" Height="40" Background="#4ecdc4" Foreground="#0f1419" FontWeight="Bold" Click="LoadGameBtn_Click" Margin="0,0,10,0"/>
            <Button Content="Удалить" Width="100" Height="40" Background="#ff6b6b" Foreground="#0f1419" FontWeight="Bold" Click="DeleteGameBtn_Click" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Width="100" Height="40" Background="#666" Foreground="#e0d5c7" Click="CloseBtn_Click"/>
        </StackPanel>

        <!-- NO GAMES MESSAGE -->
        <TextBlock Grid.Row="1" x:Name="NoGamesMessage" Text="Сохранённых игр не найдено" 
                   FontSize="16" Foreground="#a09080" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Visibility="Collapsed"/>
    </Grid>
</Window>
