<Window x:Class="ArmyBattle.UI.GameHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📜 История Игр" 
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="История Всех Игр" FontSize="24" FontWeight="Bold" Foreground="#ffd93d" Margin="0,0,0,16"/>

        <!-- GAMES LIST -->
        <StackPanel Grid.Row="1" Margin="0,0,0,0">
            <TextBlock Text="Завершённые Игры:" Foreground="#95e1d3" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="HistoryListBox" Background="#1a1f2e" Foreground="#e0d5c7" 
                         BorderBrush="#2a3a4a" BorderThickness="1" 
                         SelectionChanged="HistoryListBox_SelectionChanged"/>
            </ScrollViewer>
        </StackPanel>

        <!-- SELECTED GAME DETAILS -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Детали Выбранной Игры:" Foreground="#95e1d3" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="1" Padding="16" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="180">
                    <TextBlock x:Name="GameDetailsText" Text="Выберите игру для просмотра деталей" 
                               Foreground="#a09080" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Закрыть" Width="100" Height="40" Background="#666" Foreground="#e0d5c7" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>