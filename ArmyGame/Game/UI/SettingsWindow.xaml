<Window x:Class="ArmyBattle.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ Настройки" 
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Параметры Игры" FontSize="24" FontWeight="Bold" Foreground="#ffd93d" Margin="0,0,0,20"/>

        <!-- SETTINGS -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            
            <!-- LOGGING SECTION -->
            <Border Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Логирование" Foreground="#95e1d3" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <CheckBox x:Name="EnableLoggingCheckbox" Content="Включить логирование боевых действий" 
                              Foreground="#a09080" IsChecked="True" Margin="0,0,0,8"/>
                    <TextBlock Text="Логи сохраняются в файл для последующего анализа боёв" 
                               Foreground="#a09080" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- SOUND SECTION -->
            <Border Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Звук" Foreground="#95e1d3" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <CheckBox x:Name="EnableDeathSoundCheckbox" Content="Звук смерти юнита при поражении" 
                              Foreground="#a09080" IsChecked="True" Margin="0,0,0,8"/>
                    <TextBlock Text="При отключении звуки боевых действий будут отключены" 
                               Foreground="#a09080" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- BATTLE SPEED SECTION -->
            <Border Background="#1a1f2e" BorderBrush="#2a3a4a" BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Скорость Боя" Foreground="#95e1d3" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Медленно" Foreground="#a09080" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="BattleSpeedSlider" Width="250" Minimum="100" Maximum="1000" Value="400" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Быстро" Foreground="#a09080" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="120" Height="40" Background="#2ecc71" Foreground="#0f1419" FontWeight="Bold" Click="SaveBtn_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="100" Height="40" Background="#666" Foreground="#e0d5c7" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
