<Window x:Class="ArmyBattle.UI.BattleResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚔ Битва Завершена ⚔" 
        Width="550" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#0f1419"
        Foreground="#e0d5c7"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#ffd93d"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#95e1d3"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>
        
        <Style x:Key="StatTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#e0d5c7"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#2a1a1a"/>
            <Setter Property="Foreground" Value="#ff6b6b"/>
            <Setter Property="BorderBrush" Value="#ff6b6b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="OkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="#1a3a2a"/>
            <Setter Property="Foreground" Value="#2ecc71"/>
            <Setter Property="BorderBrush" Value="#2ecc71"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#0f1419" BorderBrush="#2a3a4a" BorderThickness="2" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <!-- Кнопка закрыть -->
            <Button Grid.Row="0" Content="✖" HorizontalAlignment="Right" 
                    Style="{StaticResource CloseButtonStyle}" Click="CloseBtn_Click"/>
            
            <!-- Заголовок -->
            <TextBlock Grid.Row="1" Text="БИТВА ЗАВЕРШЕНА" Style="{StaticResource HeaderStyle}"/>
            
            <!-- Разделитель -->
            <Border Grid.Row="2" Height="1" Background="#2a3a4a" Margin="0,10,0,10"/>
            
            <!-- Победитель -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="🏆 ПОБЕДИТЕЛЬ 🏆" FontSize="20" FontWeight="Bold" 
                           Foreground="#2ecc71" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="WinnerNameText" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>
            
            <!-- Статистика -->
            <TextBlock Grid.Row="4" Text="СТАТИСТИКА БИТВЫ" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,5"/>
            
            <TextBlock Grid.Row="5" Text="═══════════════════════════════════════" 
                       Foreground="#a09080" FontSize="12" HorizontalAlignment="Center"/>
            
            <Border Grid.Row="6" Background="#1a1f2e" CornerRadius="8" Padding="16" Margin="0,10,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <TextBlock x:Name="StatsText" Style="{StaticResource StatTextStyle}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
            
            <!-- Кнопка ОК -->
            <Button Grid.Row="7" Content="Продолжить" HorizontalAlignment="Center" Margin="0,15,0,10"
                    Style="{StaticResource OkButtonStyle}" Click="OkBtn_Click"/>
        </Grid>
    </Border>
</Window>